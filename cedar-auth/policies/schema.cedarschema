namespace AgentTools {
  type Context = {
    session: Session
  };

  type Session = {
    role: String
  };

  type commentInput = {
    resource_id: String,
    text: String
  };

  type delete_fileInput = {
    path: String
  };

  type executeInput = {
    command: String,
    path?: String
  };

  type list_directoryInput = {
    path: String
  };

  type query_databaseInput = {
    database?: String,
    query: String
  };

  type read_fileInput = {
    path: String
  };

  type viewInput = {
    resource_id: String
  };

  type write_fileInput = {
    content: String,
    path: String
  };

  entity Album in [Album] = {
    tag: String
  };

  entity Resource = {
    path: String,
    tag: String
  };

  entity User in [UserGroup];

  entity UserGroup;

  action "comment" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: commentInput
    }
  };

  action "delete_file" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: delete_fileInput
    }
  };

  action "execute" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: executeInput
    }
  };

  action "list_directory" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: list_directoryInput
    }
  };

  action "query_database" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: query_databaseInput
    }
  };

  action "read_file" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: read_fileInput
    }
  };

  action "view" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: viewInput
    }
  };

  action "write_file" appliesTo {
    principal: [User, UserGroup],
    resource: [Album, Resource],
    context: {
      session: Session,
      input: write_fileInput
    }
  };
}
