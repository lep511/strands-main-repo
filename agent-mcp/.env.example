# AWS credentials for Amazon Bedrock — used by the Strands agent (agent_service)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# Where the agent finds the MCP server (agent_service)
MCP_SERVER_URL=http://localhost:8000/mcp

# Bind address/port for the MCP server (mcp_server)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: shared key (>= 32 bytes) so every replica behind a load balancer can
# unseal the requestState carried between multi round-trip rounds (SEP-2322).
# Unset = ephemeral per-process key, fine for a single server process.
# REQUEST_STATE_KEY=change-me-to-at-least-32-random-bytes-please
